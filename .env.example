# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# FONNTE_TOKEN: Backend-only WhatsApp Fonnte Device/API Token.
# Configure this in AI Studio Secrets or Vercel Environment Variables.
# NEVER expose this token to the frontend or commit real tokens here.
FONNTE_TOKEN=""

# VITE_GOOGLE_MAPS_API_KEY: Provisioned via Google Maps Platform in AI Studio.
# Used by @vis.gl/react-google-maps on the frontend to render interactive branch maps.
VITE_GOOGLE_MAPS_API_KEY=""
